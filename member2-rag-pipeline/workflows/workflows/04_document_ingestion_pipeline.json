      ],
      "credentials": {
        "qdrantApi": {
          "id": "AteJ0CZnuqc8baxq",
          "name": "Qdrant account"
        }
      },
      "notes": "Stores embeddings + text + metadata in the 'ulbs_documents' collection. Distance metric: Cosine similarity. Vector size matches embedding model (1536 for OpenAI, 384 for nomic)."
    },
    {
      "parameters": {
        "jsCode": "// Final summary of ingestion results\nconst items = $input.all();\nconst summary = {\n  status: 'INGESTION_COMPLETE',\n  total_chunks_stored: items.length,\n  timestamp: new Date().toISOString(),\n  collection: 'ulbs_documents',\n  message: `Successfully ingested ${items.length} document chunks into Qdrant.`\n};\n\nconsole.log(JSON.stringify(summary, null, 2));\nreturn [{ json: summary }];"
      },
