      },
      "id": "9698d4eb-a14a-43a1-8a84-f96554dc56cc",
      "name": "Read Document Files",
      "type": "n8n-nodes-base.readBinaryFiles",
      "typeVersion": 1,
      "position": [
        -640,
        176
      ],
      "notes": "Reads all PDF, DOCX, TXT, HTML files from the mounted Docker volume"
    },
    {
      "parameters": {
        "jsCode": "// Add metadata - works correctly with Switch+Merge for multiple file types\n\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  // Extrage numele salvat de nodul Edit Fields (Set) anterior, sau folosește 'unknown'\n  const fileName = item.json?.fileName || 'unknown';\n  const fileExtension = fileName !== 'unknown' ? fileName.split('.').pop().toLowerCase() : 'unknown';\n  \n  // Get the extracted text content\n  const text = item.json?.text \n            || item.json?.data \n            || item.json?.content \n            || item.json?.pageContent\n            || '';\n  \n  console.log(`Processing: ${fileName} (${fileExtension}) - ${text.length} chars`);\n  \n  if (!text || text.trim().length < 50) {\n    console.log(`Skipping ${fileName}: insufficient text`);\n    continue;\n  }\n  \n  results.push({\n    json: {\n      fileName: fileName,\n      text: `Source File: ${fileName}\\n\\n${text.trim()}`,\n      metadata: {\n        source_file: fileName,\n        file_type: fileExtension,\n        ingested_at: new Date().toISOString(),\n        char_count: text.trim().length,\n        estimated_tokens: Math.ceil(text.trim().length / 4)\n      }\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "2eae47f3-b466-46fd-926d-b9b5699e45c3",
      "name": "Add Document Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        176
      ],
      "notes": "Attaches source filename, timestamp, char count to each document"
    },
