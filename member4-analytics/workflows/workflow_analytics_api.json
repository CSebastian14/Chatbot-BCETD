    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT (SELECT COUNT(*) FROM query_logs WHERE created_at >= NOW() - INTERVAL '7 days') AS queries_7d, (SELECT COUNT(*) FROM query_logs WHERE created_at >= NOW() - INTERVAL '1 day') AS queries_24h, (SELECT ROUND(100.0 * COUNT(*) FILTER (WHERE was_answered) / NULLIF(COUNT(*), 0), 1) FROM query_logs WHERE created_at >= NOW() - INTERVAL '7 days') AS success_rate_7d, (SELECT ROUND(AVG(response_ms)) FROM query_logs WHERE created_at >= NOW() - INTERVAL '7 days' AND was_answered = TRUE) AS avg_response_ms, (SELECT COUNT(DISTINCT session_id) FROM query_logs WHERE created_at >= NOW() - INTERVAL '7 days') AS unique_sessions_7d;",
        "options": {}
      },
